{
  "name": "rhythmeyez",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "songs": "node tools/compose/build-songs.mjs",
    "check-charts": "node tools/check-charts.mjs",
    "typesense": "bash server/scripts/start-typesense.sh",
    "typesense:stop": "bash server/scripts/stop-typesense.sh",
    "typesense:up": "docker compose up -d typesense",
    "typesense:setup": "node tools/typesense-setup.mjs",
    "ingest": "node tools/ingest.mjs",
    "exclude-song": "node tools/exclude-song.mjs",
    "server": "node server/index.js",
    "server:install": "npm --prefix server ci",
    "test:online": "ONLINE_IT=1 vitest run test/online-integration.test.js",
    "fetch-voice-model": "node tools/fetch-voice-model.mjs",
    "typesense:seed": "node tools/typesense-seed.mjs",
    "render:keys": "node tools/render-keys.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "vosk-browser": "0.0.8"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

# Copy to game/.env and fill in. Never commit .env (it is gitignored).
# Variables starting with VITE_ are sent to the browser: only put PUBLIC values there.

# ---- Typesense (server side: tools/ and server/ only) ----
# Local Docker: host localhost, port 8108, protocol http.
# Typesense Cloud: host xxx.a1.typesense.net, port 443, protocol https.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_COLLECTION=songs
# Admin key: full access. Scripts and game/server only. For local Docker, choose any long random string.
TYPESENSE_ADMIN_API_KEY=change-me-to-a-long-random-string
# Search-only key: printed by `npm run typesense:setup`.
TYPESENSE_SEARCH_API_KEY=

# ---- Typesense (browser: search-only!) ----
VITE_TYPESENSE_URL=http://localhost:8108
VITE_TYPESENSE_SEARCH_API_KEY=

# ---- Licensing ----
# NoDerivatives tracks are always excluded. NonCommercial tracks are excluded unless this is true.
ALLOW_NONCOMMERCIAL=false

# ---- Ingestion ----
# Optional override of the User-Agent sent to archive.org.
# INGEST_USER_AGENT=RhythmEyez-ingest/1.0 (+https://your-project-url)

# ---- Optional remote results database (existing feature) ----
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon key>
